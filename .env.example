# Backend API URL
VITE_API_URL=http://localhost:8000

# Google Books API key
VITE_GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Public deployment: shows "Create account" and "Continue as visitor" on the login screen
# right away (the API confirms through /ping). Leave false on a private deployment.
VITE_DEMO_MODE=false
